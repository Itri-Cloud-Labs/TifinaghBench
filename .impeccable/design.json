  "components": [
    {
      "name": "Header Rail",
      "kind": "nav",
      "refersTo": "header-rail",
      "description": "Clay rail with the ⵣ wordmark, text nav, EN/FR switch; sawtooth hem below.",
      "html": "<header class=\"ds-rail\"><div class=\"ds-rail-in\"><a class=\"ds-mark\" href=\"#\"><span lang=\"zgh\" class=\"ds-z\">ⵣ</span><b>TifinaghBench</b></a><nav><a class=\"ds-nav ds-on\" href=\"#\">Leaderboard</a><a class=\"ds-nav\" href=\"#\">Compare</a><a class=\"ds-nav\" href=\"#\">Methodology</a></nav><span class=\"ds-lang\"><a class=\"ds-cur\" href=\"#\">EN</a><a href=\"#\">FR</a></span></div><div style=\"background:var(--slip,#f5f5f2)\"><svg width=\"100%\" height=\"8\" aria-hidden=\"true\" style=\"display:block\"><defs><pattern id=\"ds-hem\" width=\"16\" height=\"8\" patternUnits=\"userSpaceOnUse\"><path d=\"M0 0h16L8 8Z\" fill=\"var(--clay,#9c3a22)\"/></pattern></defs><rect width=\"100%\" height=\"8\" fill=\"url(#ds-hem)\"/></svg></div></header>",
      "css": ".ds-rail{background:var(--clay,#9c3a22);color:var(--clay-ink,#f7efe6);font-family:'Archivo Variable','Archivo',ui-sans-serif,system-ui,sans-serif;}.ds-rail-in{display:flex;align-items:center;gap:24px;padding:12px 32px}.ds-mark{display:flex;align-items:center;gap:10px;color:var(--clay-ink,#f7efe6);text-decoration:none;font-size:1.125rem;letter-spacing:-0.01em}.ds-z{font-family:'Noto Sans Tifinagh',sans-serif;font-size:1.65rem;line-height:1}.ds-rail nav{display:flex;gap:4px}.ds-nav{display:block;padding:6px 12px;border-radius:2px;font-size:.875rem;font-weight:500;color:var(--clay-ink-2,#f0d7c7);text-decoration:none;transition:background-color 150ms,color 150ms}.ds-nav:hover,.ds-nav.ds-on{background:var(--clay-deep,#7c2c18);color:var(--clay-ink,#f7efe6)}.ds-nav:focus-visible,.ds-lang a:focus-visible{outline:2px solid var(--focus,#1769aa);outline-offset:2px}.ds-lang{margin-left:auto;display:flex;border:1px solid rgba(247,239,230,.35);border-radius:2px;font-size:.75rem;font-weight:600}.ds-lang a{padding:4px 8px;color:var(--clay-ink,#f7efe6);text-decoration:none}.ds-lang a:hover{background:var(--clay-deep,#7c2c18)}.ds-lang a.ds-cur{background:var(--clay-ink,#f7efe6);color:var(--clay,#9c3a22)}"
    },
