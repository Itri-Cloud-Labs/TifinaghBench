      "kind": "button",
      "refersTo": "button-quiet",
      "description": "The only content button style: outlined, 2px corners, wet-slip hover.",
      "html": "<button class=\"ds-btn\">Reset filters</button>",
      "css": ".ds-btn{font-family:'Archivo Variable','Archivo',ui-sans-serif,system-ui,sans-serif;font-size:.875rem;color:var(--ink,#241a14);background:transparent;border:1px solid var(--rule-strong,#b3ab9c);border-radius:2px;padding:6px 12px;cursor:pointer;transition:background-color 150ms}.ds-btn:hover{background:var(--slip-2,#ecebe6)}.ds-btn:focus-visible{outline:2px solid var(--focus,#1769aa);outline-offset:2px}"
