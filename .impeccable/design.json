      "html": "<label class=\"ds-field\"><span class=\"ds-label\">Harness</span><select class=\"ds-select\"><option>All</option><option>Codex</option></select></label>",
      "css": ".ds-field{display:inline-flex;flex-direction:column;gap:4px;font-family:'Archivo Variable','Archivo',ui-sans-serif,system-ui,sans-serif;}.ds-label{font-size:.75rem;font-weight:600;letter-spacing:.04em;text-transform:uppercase;font-variation-settings:'wdth' 88;color:var(--ink-2,#5a4c42)}.ds-select{height:36px;min-width:144px;padding:0 8px;font:inherit;font-size:.875rem;color:var(--ink,#241a14);background:var(--slip,#f5f5f2);border:1px solid var(--rule-strong,#b3ab9c);border-radius:2px}.ds-select:hover{border-color:var(--ink-3,#75675c)}.ds-select:focus-visible{outline:2px solid var(--focus,#1769aa);outline-offset:2px}"
